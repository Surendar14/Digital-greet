{
  "id": "welcome",
  "type": "hero",
  "label": "Welcome",
  "enabled": true,
  "order": 1,
  "animation": { "preset": "blurIn", "duration": 1.2 },
  "style": {
    "fullHeight": true,
    "background": {
      "image": "assets/backgrounds/rose-full.jpg",
