{
  "id": "story",
  "type": "text",
  "label": "Our Story",
  "enabled": true,
  "order": 3,
  "animation": { "preset": "fadeUp", "stagger": 0.12 },
  "style": {
    "maxWidth": "760px",
    "background": {
      "image": "assets/backgrounds/rose-shallow.jpg",
      "position": "28% 78%",
      "opacity": 0.7
    }
  },
  "content": {
    "kicker": "@story_kicker",
    "title": "@story_title",
    "body": "@story_paragraphs",
    "signature": "@story_signature"
  }
}